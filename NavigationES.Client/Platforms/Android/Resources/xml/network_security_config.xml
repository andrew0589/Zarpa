<?xml version="1.0" encoding="utf-8" ?>
<network-security-config>
	<domain-config cleartextTrafficPermitted="true">
		<!-- Android emulator's alias for the host machine. -->
		<domain includeSubdomains="true">10.0.2.2</domain>
		<!-- iOS-style LAN fallback / dev machine IP (see DevelopmentEnvironmentService). -->
		<domain includeSubdomains="true">192.168.1.136</domain>
		<!-- Local Google-login testing: the app calls http://localhost:7136, tunneled to the PC via "adb reverse". -->
		<domain includeSubdomains="true">localhost</domain>
	</domain-config>
</network-security-config>

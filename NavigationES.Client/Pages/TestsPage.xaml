<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NavigationES.Client.Pages.TestsPage"
             Title="{x:Static lang:AppResources.TabTests}"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:TestsViewModel"
             BackgroundColor="#F2F4F8">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="{StaticResource Accent}">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" MaximumWidthRequest="500" Spacing="0">

            <!-- Which qualification the user prepares for; sessions are created against it. -->
            <Label Text="{x:Static lang:AppResources.YourLicenseLabel}"
                   TextColor="{StaticResource Gray600}"
                   FontSize="12"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextTransform="Uppercase" />
            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0"
                                   BindableLayout.ItemsSource="{Binding Licenses}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LicenseOptionItem">
                        <Border BackgroundColor="White"
                                Stroke="#D8DEE6"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectLicenseCommand, Source={RelativeSource AncestorType={x:Type vm:TestsViewModel}}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Code}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="14"
                                   FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
            <Label Text="{Binding SelectedLicenseName}"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"
                   IsVisible="{Binding SelectedLicenseName, Converter={StaticResource IsNotNullConverter}}"
                   Margin="2,6,0,0" />

            <!-- Exam simulation (timed) -->
            <Border Style="{StaticResource ModeCard}" Margin="0,20,0,0">
                <Border.Shadow>
                    <Shadow Brush="#1A102A43" Offset="0,6" Radius="16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ExamSimulation_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource ModeIconTile}">
                        <Label Text="{x:Static fa:Solid.Stopwatch}" Style="{StaticResource ModeIcon}" />
                    </Border>
                    <Label Text="{x:Static lang:AppResources.ExamSimulationTitle}"
                           Style="{StaticResource ModeTitle}"
                           Margin="0,16,0,0" />
                    <Label Text="{x:Static lang:AppResources.ExamSimulationDescription}"
                           Style="{StaticResource ModeDescription}"
                           Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <Label Grid.Column="0"
                               Text="{x:Static lang:AppResources.StartSimulation}"
                               Style="{StaticResource ModeAction}" />
                        <Label Grid.Column="1"
                               Text="{x:Static fa:Solid.ArrowRight}"
                               Style="{StaticResource ModeActionArrow}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Learning mode (untimed, with explanations): two ways to practice -->
            <Border Style="{StaticResource ModeCard}" Margin="0,18,0,0">
                <Border.Shadow>
                    <Shadow Brush="#1A102A43" Offset="0,6" Radius="16" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource ModeIconTile}">
                        <Label Text="{x:Static fa:Solid.BookOpen}" Style="{StaticResource ModeIcon}" />
                    </Border>
                    <Label Text="{x:Static lang:AppResources.LearningModeTitle}"
                           Style="{StaticResource ModeTitle}"
                           Margin="0,16,0,0" />
                    <Label Text="{x:Static lang:AppResources.LearningModeDescription}"
                           Style="{StaticResource ModeDescription}"
                           Margin="0,8,0,0" />
                    <Button Text="{x:Static lang:AppResources.PracticeByTopicTitle}"
                            Clicked="PracticeByTopic_Clicked"
                            CornerRadius="10"
                            Margin="0,16,0,0" />
                    <Button Text="{x:Static lang:AppResources.PracticeLikeExamTitle}"
                            Clicked="PracticeLikeExam_Clicked"
                            CornerRadius="10"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
    <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{StaticResource Accent}" />
    </Grid>
</ContentPage>

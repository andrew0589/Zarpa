<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             xmlns:utils="clr-namespace:NavigationES.Client.Utilities"
             x:Class="NavigationES.Client.Pages.SigninPage"
             Title="{x:Static lang:AppResources.SignIn}"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:AuthViewModel"
             BackgroundColor="#F2F4F8">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gray600}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#D8DEE6" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
            <Style x:Key="FieldIcon" TargetType="Label">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Gray300}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="ErrorLabel" TargetType="Label">
                <Setter Property="TextColor" Value="Red" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SocialButton" TargetType="ImageButton">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="BorderColor" Value="#DDDDDD" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="16,24">
            <!-- The sign-in card -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 24"
                    Padding="26,32"
                    MaximumWidthRequest="430"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#26102A43" Offset="0,12" Radius="24" />
                </Border.Shadow>
                <Grid>
                    <input:FormView x:Name="SigninForm" SubmitCommand="{Binding SigninCommand}">
                        <VerticalStackLayout Spacing="0">

                            <!-- Brand: monogram tile + name + tagline -->
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18"
                                    WidthRequest="76"
                                    HeightRequest="76"
                                    HorizontalOptions="Center">
                                <Label Text="Z"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="40"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="NavigationES"
                                   TextTransform="Uppercase"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2"
                                   HorizontalOptions="Center"
                                   Margin="0,16,0,0" />
                            <Label Text="{x:Static lang:AppResources.AppTagline}"
                                   TextColor="{StaticResource Gray500}"
                                   FontSize="15"
                                   HorizontalOptions="Center"
                                   Margin="0,6,0,26" />

                            <!-- Email -->
                            <Label Text="{x:Static lang:AppResources.Email}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,0,0,8" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{x:Static fa:Solid.Envelope}"
                                           Style="{StaticResource FieldIcon}" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Email}"
                                           Placeholder="{x:Static lang:AppResources.EmailPlaceholder}"
                                           Keyboard="Email"
                                           Style="{StaticResource FieldEntry}">
                                        <Entry.Behaviors>
                                            <utils:FocusBorderBehavior />
                                        </Entry.Behaviors>
                                    </Entry>
                                </Grid>
                            </Border>
                            <Label Text="{Binding EmailErrorMessage}"
                                   IsVisible="{Binding ShowEmailError}"
                                   Style="{StaticResource ErrorLabel}"
                                   Margin="2,6,0,0" />

                            <!-- Password label + forgot link on the same row -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,8">
                                <Label Grid.Column="0"
                                       Text="{x:Static lang:AppResources.Password}"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="2,0,0,0"
                                       VerticalOptions="End" />
                                <Label Grid.Column="1"
                                       Text="{x:Static lang:AppResources.ForgotPassword}"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextDecorations="Underline"
                                       VerticalOptions="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Border Style="{StaticResource FieldBorder}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{x:Static fa:Solid.Lock}"
                                           Style="{StaticResource FieldIcon}" />
                                    <Entry x:Name="PasswordEntry"
                                           Grid.Column="1"
                                           Text="{Binding Password}"
                                           Placeholder="{x:Static lang:AppResources.PasswordPlaceholder}"
                                           IsPassword="True"
                                           Style="{StaticResource FieldEntry}">
                                        <Entry.Behaviors>
                                            <utils:FocusBorderBehavior />
                                        </Entry.Behaviors>
                                    </Entry>
                                    <Label x:Name="PasswordEyeIcon"
                                           Grid.Column="2"
                                           Text="{x:Static fa:Solid.Eye}"
                                           Style="{StaticResource FieldIcon}"
                                           Padding="6,12">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TogglePasswordVisibility_Tapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                            <Label Text="{Binding PasswordErrorMessage}"
                                   IsVisible="{Binding ShowPasswordError}"
                                   Style="{StaticResource ErrorLabel}"
                                   Margin="2,6,0,0" />

                            <Button Text="{x:Static lang:AppResources.SignInButton}"
                                    input:FormView.IsSubmitButton="True"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    Margin="0,22,0,0" />

                            <!-- Sign-up link -->
                            <Label HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,18,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static lang:AppResources.NoAccountQuestion}"
                                              TextColor="{StaticResource Gray500}"
                                              FontSize="14" />
                                        <Span Text=" " FontSize="14" />
                                        <Span Text="{x:Static lang:AppResources.CreateNewAccount}"
                                              TextColor="{StaticResource Primary}"
                                              FontSize="14"
                                              FontAttributes="Bold"
                                              TextDecorations="Underline" />
                                    </FormattedString>
                                </Label.FormattedText>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SignupLabel_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Social login: WebAuthenticator has no Windows implementation, so the block is hidden there. -->
                            <VerticalStackLayout Spacing="15" Margin="0,24,0,0">
                                <VerticalStackLayout.IsVisible>
                                    <OnPlatform x:TypeArguments="x:Boolean" Default="True">
                                        <On Platform="WinUI" Value="False" />
                                    </OnPlatform>
                                </VerticalStackLayout.IsVisible>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                    <BoxView Grid.Column="0" HeightRequest="1" Color="#DDDDDD" VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{x:Static lang:AppResources.OrContinueWith}"
                                           TextColor="Gray"
                                           FontSize="13" />
                                    <BoxView Grid.Column="2" HeightRequest="1" Color="#DDDDDD" VerticalOptions="Center" />
                                </Grid>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="25">
                                    <ImageButton Source="google_logo.png"
                                                 Command="{Binding GoogleSigninCommand}"
                                                 Style="{StaticResource SocialButton}" />
                                    <ImageButton Source="apple_logo.png"
                                                 Command="{Binding AppleSigninCommand}"
                                                 Style="{StaticResource SocialButton}" />
                                    <ImageButton Source="facebook_logo.png"
                                                 Command="{Binding FacebookSigninCommand}"
                                                 Style="{StaticResource SocialButton}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </input:FormView>
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       Color="{StaticResource Accent}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             xmlns:controls="clr-namespace:NavigationES.Client.Controls"
             x:Class="NavigationES.Client.Pages.ExamsPage"
             Title="{x:Static lang:AppResources.ExamSimulationTitle}"
             x:DataType="vm:ExamsViewModel"
             BackgroundColor="#F2F4F8">

    <Grid>
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="{StaticResource Accent}">
    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,32" MaximumWidthRequest="600" Spacing="0">

            <Label Text="{x:Static lang:AppResources.UnknownError}"
                   TextColor="Red"
                   FontSize="14"
                   IsVisible="{Binding LoadFailed}" />

            <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowList}">
                <!-- "Exámenes oficiales de PER — Comunidad. Se filtran por tu titulación y tu comunidad — se cambian en Perfil." -->
                <Label TextColor="{StaticResource Gray600}" FontSize="14" LineHeight="1.3">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static lang:AppResources.ExamsTaglinePrefix}" />
                            <Span Text="{Binding LicenseCode}" FontAttributes="Bold" TextColor="{StaticResource OffBlack}" />
                            <Span Text="{Binding ComunidadSuffix}" />
                            <Span Text="{x:Static lang:AppResources.ExamsTaglineSuffix}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="{x:Static lang:AppResources.NoExamsAvailable}"
                       TextColor="{StaticResource Gray500}"
                       FontSize="14"
                       Margin="0,20,0,0"
                       IsVisible="{Binding IsEmpty}" />

                <!-- Papers grouped by year, newest first -->
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Years}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExamYearGroup">
                            <VerticalStackLayout Spacing="0" Margin="0,22,0,0">
                                <Label Text="{Binding YearText}"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="17"
                                       FontAttributes="Bold" />
                                <controls:DashedRule Margin="0,6,0,12" />

                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Exams}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExamListItem">
                                            <Border BackgroundColor="White"
                                                    Stroke="#D8DEE6"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="14,12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenExamCommand, Source={RelativeSource AncestorType={x:Type vm:ExamsViewModel}}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding MonthYear}"
                                                           TextColor="{StaticResource OffBlack}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Border Grid.Row="0" Grid.Column="1"
                                                            BackgroundColor="{Binding StatusBackground}"
                                                            Stroke="Transparent"
                                                            StrokeShape="RoundRectangle 99"
                                                            Padding="10,3"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding HasStatus}">
                                                        <Label Text="{Binding StatusText}"
                                                               TextColor="{Binding StatusTextColor}"
                                                               FontSize="12"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            Stroke="Transparent"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="9,3"
                                                            HorizontalOptions="Start">
                                                        <Label Text="{Binding ModelText}"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding Meta}"
                                                           TextColor="{StaticResource Gray400}"
                                                           FontSize="13" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
    <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{StaticResource Accent}" />
    </Grid>
</ContentPage>

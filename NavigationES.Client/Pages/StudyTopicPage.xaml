<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="NavigationES.Client.Pages.StudyTopicPage"
             Title="{Binding Eyebrow}"
             x:DataType="vm:StudyTopicViewModel"
             BackgroundColor="White">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout MaximumWidthRequest="600" Spacing="0">
                <!-- Chapter cover, 16:9 -->
                <Grid HeightRequest="220" BackgroundColor="#DBEAF2">
                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                </Grid>

                <VerticalStackLayout Padding="16,18,16,8" Spacing="8">
                    <Label Text="{Binding Eyebrow}" TextColor="#1E7F7B" FontSize="12" FontAttributes="Bold"
                           CharacterSpacing="0.6" />
                    <Label Text="{Binding Name}" TextColor="{StaticResource Primary}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                           TextColor="{StaticResource Gray600}" FontSize="14" />
                    <Label Text="{Binding Facts}" TextColor="{StaticResource Gray600}" FontSize="13" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}" />
                    <Label Text="{x:Static lang:AppResources.StudyNoVideos}" IsVisible="{Binding IsEmpty}"
                           TextColor="{StaticResource Gray600}" FontSize="14" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Padding="16,0,16,16" BindableLayout.ItemsSource="{Binding Videos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudyVideoRowItem">
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12" Padding="0,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenVideoCommand, Source={RelativeSource AncestorType={x:Type vm:StudyTopicViewModel}}}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        HeightRequest="68" BackgroundColor="#E4E8EF">
                                    <Grid>
                                        <Image Source="{Binding Image}" Aspect="AspectFill" />
                                        <BoxView Color="#8C0B3D5C" IsVisible="{Binding IsLocked}" />
                                        <Label Text="{x:Static fa:Solid.Lock}" FontFamily="FASolid" TextColor="White" FontSize="18" IsVisible="{Binding IsLocked}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border BackgroundColor="#C7141414" Stroke="Transparent" StrokeShape="RoundRectangle 5"
                                                Padding="5,1" Margin="5" HorizontalOptions="End" VerticalOptions="End">
                                            <Label Text="{Binding DurationText}" TextColor="White" FontSize="11" />
                                        </Border>
                                        <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}"
                                                     VerticalOptions="End" HeightRequest="3" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Code}" TextColor="{StaticResource Gray600}" FontSize="12" />
                                    <Label Text="{Binding Title}" TextColor="{StaticResource OffBlack}" FontSize="15"
                                           FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border IsVisible="{Binding IsFree}" BackgroundColor="#E6F4F3" Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6" Padding="6,1">
                                            <Label Text="{x:Static lang:AppResources.StudyFree}" TextColor="#13615E"
                                                   FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Border IsVisible="{Binding IsDraft}" BackgroundColor="#FCEFC7" Stroke="Transparent"
                                                StrokeShape="RoundRectangle 6" Padding="6,1">
                                            <Label Text="{x:Static lang:AppResources.StudyDraft}" TextColor="#7A5300"
                                                   FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="{Binding StateText}" TextColor="{Binding StateColor}"
                                               FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky actions -->
        <VerticalStackLayout Grid.Row="1" Padding="16,10,16,14" Spacing="8" BackgroundColor="White">
            <BoxView HeightRequest="1" Color="#D8DEE6" Margin="-16,-10,-16,0" />
            <Button Text="{Binding ResumeText}" IsVisible="{Binding HasResume}" Command="{Binding ResumeCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold"
                    CornerRadius="12" HeightRequest="50" />
            <Button Text="{Binding PracticeText}" Command="{Binding PracticeCommand}"
                    BackgroundColor="White" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}"
                    BorderWidth="1" CornerRadius="12" HeightRequest="46" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" Color="{StaticResource Accent}" />
    </Grid>
</ContentPage>

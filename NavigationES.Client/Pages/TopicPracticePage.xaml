<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             xmlns:controls="clr-namespace:NavigationES.Client.Controls"
             x:Class="NavigationES.Client.Pages.TopicPracticePage"
             Title="{x:Static lang:AppResources.PracticeByTopicTitle}"
             x:DataType="vm:TopicPracticeViewModel"
             BackgroundColor="#F2F4F8">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- The web's .retro-card / .retro-title -->
            <Style x:Key="RetroCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#D8DEE6" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="20,18,20,22" />
            </Style>
            <Style x:Key="RetroTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource OffBlack}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <!-- The web's 1.5px dashed separators (.retro-title, .datos-row, .stats-summary) -->
            <Style x:Key="RetroRule" TargetType="controls:DashedRule">
                <Setter Property="Margin" Value="0,10,0,16" />
            </Style>
            <Style x:Key="LegendLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gray600}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="LegendValue" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource OffBlack}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="LegendChip" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="12" />
                <Setter Property="HeightRequest" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="{StaticResource Accent}">
    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,32" MaximumWidthRequest="600" Spacing="18">

            <Label Text="{x:Static lang:AppResources.UnknownError}"
                   TextColor="Red"
                   FontSize="14"
                   IsVisible="{Binding LoadFailed}" />

            <!-- Selecciona un tema: the square topic cards -->
            <Border Style="{StaticResource RetroCard}">
                <Border.Shadow>
                    <Shadow Brush="#14102A43" Offset="3,3" Radius="0" Opacity="1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Label Text="{x:Static lang:AppResources.TopicSelectionTitle}" Style="{StaticResource RetroTitle}" />
                    <controls:DashedRule Style="{StaticResource RetroRule}" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start"
                                AlignContent="Start"
                                Margin="-6"
                                BindableLayout.ItemsSource="{Binding Topics}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopicProgressItem">
                                <Grid FlexLayout.Basis="50%" Padding="6">
                                    <Border BackgroundColor="White"
                                            Stroke="#D8DEE6"
                                            StrokeThickness="1.5"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,14"
                                            HeightRequest="158">
                                        <Border.Triggers>
                                            <!-- A topic without questions is greyed out, like the web's disabled square. -->
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTopicCommand, Source={RelativeSource AncestorType={x:Type vm:TopicPracticeViewModel}}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Border BackgroundColor="{StaticResource Primary}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="9,3"
                                                    HorizontalOptions="Center">
                                                <Label Text="{Binding NumberText}"
                                                       TextColor="White"
                                                       FontSize="13"
                                                       FontAttributes="Bold" />
                                            </Border>
                                            <Label Text="{Binding Name}"
                                                   TextColor="{StaticResource OffBlack}"
                                                   FontSize="13"
                                                   HorizontalTextAlignment="Center"
                                                   LineBreakMode="WordWrap"
                                                   MaxLines="2" />
                                            <Label Text="{x:Static lang:AppResources.NoQuestionsShort}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="Center"
                                                   IsVisible="{Binding IsEmpty}" />
                                            <Label Text="{Binding QuestionCountText}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="Center"
                                                   IsVisible="{Binding HasQuestions}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0"
                                                  IsVisible="{Binding HasQuestions}">
                                                <ProgressBar Grid.Column="0"
                                                             Progress="{Binding Progress}"
                                                             ProgressColor="{StaticResource Accent}"
                                                             VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding PercentText}"
                                                       TextColor="{StaticResource Gray600}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Tu progreso: donut + legend + totals -->
            <Border Style="{StaticResource RetroCard}">
                <Border.Shadow>
                    <Shadow Brush="#14102A43" Offset="3,3" Radius="0" Opacity="1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Label Text="{x:Static lang:AppResources.YourProgressTitle}" Style="{StaticResource RetroTitle}" />
                    <controls:DashedRule Style="{StaticResource RetroRule}" />

                    <Grid WidthRequest="180" HeightRequest="180" HorizontalOptions="Center" Margin="0,4,0,18">
                        <controls:DonutChart Correct="{Binding Correct}"
                                             Failed="{Binding Failed}"
                                             Remaining="{Binding Remaining}" />
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0" InputTransparent="True">
                            <Label Text="{Binding CorrectPercentText}"
                                   TextColor="{StaticResource OffBlack}"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{x:Static lang:AppResources.AciertosSub}"
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                        <BoxView Grid.Row="0" Grid.Column="0" Style="{StaticResource LegendChip}" Color="#2AA5A0" BackgroundColor="#2AA5A0" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static lang:AppResources.AciertosLabel}" Style="{StaticResource LegendLabel}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Correct}" Style="{StaticResource LegendValue}" />

                        <BoxView Grid.Row="1" Grid.Column="0" Style="{StaticResource LegendChip}" Color="#D64545" BackgroundColor="#D64545" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{x:Static lang:AppResources.FallosLabel}" Style="{StaticResource LegendLabel}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Failed}" Style="{StaticResource LegendValue}" />

                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource LegendChip}" Color="#AEBACA" BackgroundColor="#AEBACA" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{x:Static lang:AppResources.SinResponderLabel}" Style="{StaticResource LegendLabel}" />
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding Remaining}" Style="{StaticResource LegendValue}" />
                    </Grid>

                    <controls:DashedRule Style="{StaticResource RetroRule}" Margin="0,16,0,12" />
                    <Label Text="{Binding StatsSummary}"
                           TextColor="{StaticResource Gray600}"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
    <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{StaticResource Accent}" />
    </Grid>
</ContentPage>

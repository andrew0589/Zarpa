<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NavigationES.Client.Resources.Languages"
             xmlns:vm="clr-namespace:NavigationES.Client.ViewModels"
             x:Class="NavigationES.Client.Pages.TopicPracticePage"
             Title="{x:Static lang:AppResources.PracticeByTopicTitle}"
             x:DataType="vm:TopicPracticeViewModel"
             BackgroundColor="#F2F4F8">

    <Grid>
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="{StaticResource Accent}">
    <ScrollView>
        <VerticalStackLayout Padding="16,20" MaximumWidthRequest="500" Spacing="0">

            <!-- Hero: intro + global progress -->
            <Border BackgroundColor="{StaticResource Primary}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20"
                    Padding="20,22">
                <Border.Shadow>
                    <Shadow Brush="#33102A43" Offset="0,8" Radius="18" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Label Text="{x:Static lang:AppResources.TopicSelectionOverline}"
                           TextColor="{StaticResource PrimaryDark}"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextTransform="Uppercase" />
                    <Label Text="{x:Static lang:AppResources.TopicSelectionTitle}"
                           TextColor="White"
                           FontSize="24"
                           FontAttributes="Bold"
                           Margin="0,8,0,0" />
                    <Label Text="{x:Static lang:AppResources.TopicSelectionDescription}"
                           TextColor="{StaticResource Secondary}"
                           FontSize="15"
                           Margin="0,10,0,0" />

                    <!-- Global progress -->
                    <Border BackgroundColor="#1AFFFFFF"
                            Stroke="#26FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="16,14"
                            Margin="0,18,0,0">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{x:Static lang:AppResources.GlobalProgressLabel}"
                                   TextColor="{StaticResource Secondary}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextTransform="Uppercase" />
                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                <Label Text="{Binding GlobalProgressText}"
                                       TextColor="White"
                                       FontSize="30"
                                       FontAttributes="Bold" />
                                <Label Text="{x:Static lang:AppResources.CompletedSuffix}"
                                       TextColor="{StaticResource Secondary}"
                                       FontSize="14"
                                       VerticalOptions="End"
                                       Margin="0,0,0,5" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding GlobalProgress}"
                                         ProgressColor="{StaticResource Accent}"
                                         Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- The 11 topics -->
            <VerticalStackLayout Spacing="12" Margin="0,18,0,0"
                                 BindableLayout.ItemsSource="{Binding Topics}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TopicProgressItem">
                        <Border BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="#14102A43" Offset="0,4" Radius="10" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTopicCommand, Source={RelativeSource AncestorType={x:Type vm:TopicPracticeViewModel}}}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           TextColor="{StaticResource OffBlack}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           TextColor="{StaticResource Primary}"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                </Grid>
                                <HorizontalStackLayout Spacing="10" Margin="0,2,0,0">
                                    <Label Text="{Binding QuestionCountText}"
                                           TextColor="{StaticResource Gray500}"
                                           FontSize="13" />
                                    <Label Text="{Binding AciertosText}"
                                           TextColor="{StaticResource Accent}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding FallosText}"
                                           TextColor="#D64545"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <ProgressBar Progress="{Binding Progress}"
                                             ProgressColor="{StaticResource Accent}"
                                             Margin="0,10,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
    <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{StaticResource Accent}" />
    </Grid>
</ContentPage>

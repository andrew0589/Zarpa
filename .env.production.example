# Template for the Environment tab of the Dokploy application.
# Copy the keys, fill in real values THERE — this file stays in git, so it must
# never hold a real secret.

# --- Database -------------------------------------------------------------
# SQL login created on the existing `mssql` container (see DEPLOY.md, step 2).
# Not `sa`: this login only owns NavigationESDb, so a leak can't touch ChurchDb.
DB_USER=navigationes
DB_PASSWORD=

# --- JWT ------------------------------------------------------------------
# HMAC-SHA256 signing key. At least 32 bytes, random. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# --- Admin import endpoints ----------------------------------------------
# X-Admin-Key header for /api/admin/*. Leave blank and those endpoints stay off.
#   openssl rand -hex 32
ADMIN_API_KEY=

# --- Google Sign-In -------------------------------------------------------
# OAuth client of type "Web application".
# Authorised redirect URI: https://api.navigationes.eu/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple ---------------------------------------------------
# Services ID (the web-flow client_id, not the app bundle ID).
# Return URL: https://api.navigationes.eu/api/auth/apple/callback
# APPLE_PRIVATE_KEY is the contents of the .p8 file; newlines may be written as \n.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Facebook Login -------------------------------------------------------
# Valid OAuth Redirect URI: https://api.navigationes.eu/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email (6-digit verification codes + password reset) ------------------
# Gmail requires an APP PASSWORD here, not the account password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

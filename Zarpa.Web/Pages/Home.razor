@page "/"
@attribute [Authorize]
@inject ILicensesApi LicensesApi
@inject IComunidadesApi ComunidadesApi
@inject WebAuthStateProvider Auth

<PageTitle>Zarpa</PageTitle>

<h1>Hola, @Auth.User?.Name</h1>

@if (!_loaded)
{
    <p class="page-loading">Cargando…</p>
}
else if (_selectedLicense is null)
{
    @* First run: the qualification comes first. *@
    <p class="tagline">Elige tu titulación para empezar a practicar.</p>
    <LicenseSelector OnSelected="OnLicenseChosen" />
}
else if (!_hasComunidad)
{
    @* Then the community — it decides which real exams the simulations offer. *@
    <p class="tagline">Elige tu comunidad autónoma para las simulaciones de examen.</p>
    <ComunidadSelector OnSelected="OnComunidadChosen" />
}
else
{
    @* Free for now — content comes later; navigation lives in the top bar. *@
    <p class="tagline">Prepárate para tus titulaciones náuticas</p>
}

@code {
    private LicenseDto? _selectedLicense;
    private bool _hasComunidad;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var licenses = await LicensesApi.GetLicensesAsync();
            var selection = await LicensesApi.GetSelectedLicenseAsync();
            _selectedLicense = licenses.FirstOrDefault(l => l.Id == selection.LicenseId);

            _hasComunidad = (await ComunidadesApi.GetSelectedComunidadAsync()).ComunidadId is not null;
        }
        catch (Exception)
        {
            // A 401 already redirected to /signin; on any other failure fall through
            // to the selector, which shows its own error state.
        }
        finally
        {
            _loaded = true;
        }
    }

    private void OnLicenseChosen(LicenseDto license) => _selectedLicense = license;

    private void OnComunidadChosen(ComunidadDto _) => _hasComunidad = true;
}

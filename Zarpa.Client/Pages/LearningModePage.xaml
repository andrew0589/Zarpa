<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:Zarpa.Client.Resources.Languages"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="Zarpa.Client.Pages.LearningModePage"
             Title="{x:Static lang:AppResources.LearningModeTitle}"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" MaximumWidthRequest="500" Spacing="0">

            <Label Text="{x:Static lang:AppResources.LearningModeTitle}"
                   TextColor="{StaticResource Primary}"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="{x:Static lang:AppResources.LearningModeSubtitle}"
                   TextColor="{StaticResource Gray500}"
                   FontSize="15"
                   Margin="0,6,0,0" />

            <!-- Practice a single chosen topic -->
            <Border Style="{StaticResource ModeCard}" Margin="0,22,0,0">
                <Border.Shadow>
                    <Shadow Brush="#1A102A43" Offset="0,6" Radius="16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="PracticeByTopic_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource ModeIconTile}">
                        <Label Text="{x:Static fa:Solid.LayerGroup}" Style="{StaticResource ModeIcon}" />
                    </Border>
                    <Label Text="{x:Static lang:AppResources.PracticeByTopicTitle}"
                           Style="{StaticResource ModeTitle}"
                           Margin="0,16,0,0" />
                    <Label Text="{x:Static lang:AppResources.PracticeByTopicDescription}"
                           Style="{StaticResource ModeDescription}"
                           Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <Label Grid.Column="0"
                               Text="{x:Static lang:AppResources.ChooseTopicAction}"
                               Style="{StaticResource ModeAction}" />
                        <Label Grid.Column="1"
                               Text="{x:Static fa:Solid.ArrowRight}"
                               Style="{StaticResource ModeActionArrow}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Practice with the official exam's topic distribution, untimed -->
            <Border Style="{StaticResource ModeCard}" Margin="0,18,0,0">
                <Border.Shadow>
                    <Shadow Brush="#1A102A43" Offset="0,6" Radius="16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="PracticeLikeExam_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource ModeIconTile}">
                        <Label Text="{x:Static fa:Solid.GraduationCap}" Style="{StaticResource ModeIcon}" />
                    </Border>
                    <Label Text="{x:Static lang:AppResources.PracticeLikeExamTitle}"
                           Style="{StaticResource ModeTitle}"
                           Margin="0,16,0,0" />
                    <Label Text="{x:Static lang:AppResources.PracticeLikeExamDescription}"
                           Style="{StaticResource ModeDescription}"
                           Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <Label Grid.Column="0"
                               Text="{x:Static lang:AppResources.StartPractice}"
                               Style="{StaticResource ModeAction}" />
                        <Label Grid.Column="1"
                               Text="{x:Static fa:Solid.ArrowRight}"
                               Style="{StaticResource ModeActionArrow}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

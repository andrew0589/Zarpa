<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:Zarpa.Client.Resources.Languages"
             x:Class="Zarpa.Client.Pages.StudyPage"
             Title="{x:Static lang:AppResources.TabStudy}"
             BackgroundColor="#F2F4F8">

    <VerticalStackLayout Spacing="10"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
        <Label Text="{x:Static lang:AppResources.TabStudy}"
               HorizontalOptions="Center"
               FontSize="24"
               TextColor="{StaticResource Primary}"
               FontAttributes="Bold" />
        <Label Text="{x:Static lang:AppResources.ComingSoon}"
               HorizontalOptions="Center"
               FontSize="16"
               TextColor="{StaticResource Gray500}" />
    </VerticalStackLayout>
</ContentPage>

@inject IComunidadesApi ComunidadesApi

@* Flag cards for the account's autonomous community: loads the current selection,
   click selects optimistically and persists it server-side. Used on the first-run
   home page and in Perfil. *@

@if (_comunidades is null)
{
    <p class="page-loading">Cargando…</p>
}
else if (_loadFailed)
{
    <p class="error" role="alert">Ha ocurrido un error desconocido. Por favor, inténtalo de nuevo.</p>
}
else
{
    <div class="comunidad-grid">
        @foreach (var comunidad in _comunidades)
        {
            <button class="comunidad-card @(comunidad.Id == _selectedId ? "selected" : null)"
                    @onclick="() => SelectAsync(comunidad)">
                <ComunidadFlag ComunidadId="comunidad.Id" />
                <span class="comunidad-name">@comunidad.Name</span>
                @if (comunidad.Id == _selectedId)
                {
                    <span class="license-check">✓</span>
                }
            </button>
        }
    </div>
}

@code {
    // Fires after the server accepted the new selection.
    [Parameter] public EventCallback<ComunidadDto> OnSelected { get; set; }

    private List<ComunidadDto>? _comunidades;
    private long? _selectedId;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _comunidades = await ComunidadesApi.GetComunidadesAsync();

            // The account's stored selection is the source of truth.
            _selectedId = (await ComunidadesApi.GetSelectedComunidadAsync()).ComunidadId;
        }
        catch (Exception)
        {
            _comunidades = [];
            _loadFailed = true;
        }
    }

    private async Task SelectAsync(ComunidadDto comunidad)
    {
        if (comunidad.Id == _selectedId) return;

        var previous = _selectedId;
        _selectedId = comunidad.Id;

        try
        {
            await ComunidadesApi.SelectComunidadAsync(new SelectComunidadRequestDto(comunidad.Id));
            await OnSelected.InvokeAsync(comunidad);
        }
        catch (Exception)
        {
            // The account copy did not update — undo the optimistic selection.
            _selectedId = previous;
        }
    }
}

@* A 16:9 Estudiar photo, or a labelled placeholder until the administrator sets one. *@
@if (Url is not null)
{
    <img class="study-img" src="@Url" alt="" loading="lazy" />
}
else
{
    <span class="study-img study-img-empty" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="M21 16l-5-5-8 8"></path></svg>
        <span>@Label</span>
    </span>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? Label { get; set; }
}

@inherits LayoutComponentBase
@inject WebAuthStateProvider Auth
@inject NavigationManager Navigation
@inject IStudyApi StudyApi
@implements IDisposable

<div class="page">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/"><img src="images/logo-white.svg" alt="" width="28" height="28" />NavigationES</a>
            <AuthorizeView>
                <Authorized>
                    <button class="menu-toggle" aria-label="Menú" @onclick="() => _menuOpen = !_menuOpen">☰</button>

                    @* Clicking any item closes the mobile dropdown; on desktop the
                       same nav renders inline and the handler is harmless. *@
                    <nav class="topbar-nav @(_menuOpen ? "open" : null)" @onclick="() => _menuOpen = false">
                        <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                        <NavLink href="temas">Temas</NavLink>
                        <NavLink href="examen">Examen</NavLink>
                        @* Administrators only until the API's Study:Public is switched on. *@
                        @if (_studyOpen)
                        {
                            <NavLink href="estudiar">Estudiar</NavLink>
                        }
                        <NavLink href="perfil">Perfil</NavLink>
                        <NavLink href="suscripcion">Suscripción</NavLink>
                        @if (context.User.IsInRole(WebAuthStateProvider.AdminRole))
                        {
                            <NavLink href="admin/usuarios">Usuarios</NavLink>
                            <NavLink href="admin/contenido">Contenido</NavLink>
                            <NavLink href="admin/convocatorias">Convocatorias</NavLink>
                            <NavLink href="admin/videos">Vídeos</NavLink>
                        }
                        <div class="nav-user-mobile">
                            <span class="user-name">@context.User.Identity?.Name</span>
                            <button class="btn-outline" @onclick="SignoutAsync">Cerrar sesión</button>
                        </div>
                    </nav>

                    <div class="topbar-user">
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <button class="btn-outline" @onclick="SignoutAsync">Cerrar sesión</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    @* /examenes is rendered by the API, not a Blazor route: target="_top". *@
                    <div class="topbar-guest">
                        <a class="topbar-try" href="prueba">Prueba gratis</a>
                        <a href="examenes" target="_top">Exámenes</a>
                        <a class="btn-outline btn-link" href="signin">Entrar</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    @* Static pages in wwwroot, not Blazor routes: target="_top" stops the router
       from intercepting the click so the browser loads the file. *@
    <footer class="site-footer">
        <a href="aviso-legal.html" target="_top">Aviso legal</a>
        <a href="privacidad.html" target="_top">Privacidad</a>
        <a href="cookies.html" target="_top">Cookies</a>
        <a href="terminos.html" target="_top">Términos</a>
    </footer>
</div>

@code {
    private bool _menuOpen;
    private bool _studyOpen;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RefreshStudyAccessAsync(await Auth.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        await RefreshStudyAccessAsync(await state);
        StateHasChanged();
    }

    // The API decides (admin, or Study:Public); a failed call just hides the tab.
    private async Task RefreshStudyAccessAsync(AuthenticationState state)
    {
        if (state.User.Identity?.IsAuthenticated != true)
        {
            _studyOpen = false;
            return;
        }

        try
        {
            _studyOpen = (await StudyApi.GetAccessAsync()).Enabled;
        }
        catch (Exception)
        {
            _studyOpen = false;
        }
    }

    public void Dispose() => Auth.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    private async Task SignoutAsync()
    {
        await Auth.SignoutAsync();
        Navigation.NavigateTo("signin");
    }
}

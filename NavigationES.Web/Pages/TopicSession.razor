@page "/temas/{Number:int}"
@page "/practica/{Practica}"
@attribute [Authorize]
@inject ISessionsApi SessionsApi
@inject ILicensesApi LicensesApi
@inject NavigationManager Navigation
@inject ApiOptions Api

<PageTitle>@Title — NavigationES</PageTitle>

<div class="ts-page" @ref="_pageRef" tabindex="-1" @onkeydown="OnKeyDownAsync">
<a class="back-link" href="@BackHref">←&nbsp;@BackText</a>

@if (_paywall)
{
    <h1>@Title</h1>
    <Paywall />
}
else if (_loadFailed)
{
    <h1>@Title</h1>
    <p class="error" role="alert">Ha ocurrido un error desconocido. Por favor, inténtalo de nuevo.</p>
}
else if (!_loaded)
{
    <h1>@Title</h1>
    <p class="page-loading">Cargando…</p>
}
else if (_completed)
{
    <h1>@Title</h1>
    <div class="completed-card">
        <span class="completed-check">✓</span>
        @if (Mode == PracticeKind.Topic)
        {
            <p class="completed-text">¡Has completado todas las preguntas de este tema!</p>
            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }
            <button class="btn-primary" @onclick="() => _showRestartConfirm = true">Reiniciar tema</button>
            <a class="btn-outline-dark btn-link" href="temas">Volver a los temas</a>
        }
        else
        {
            <p class="completed-text">@CompletedText</p>
            @if (_sessionCorrect + _sessionWrong > 0)
            {
                <p class="tagline">@_sessionCorrect @(_sessionCorrect == 1 ? "acierto" : "aciertos") · @_sessionWrong @(_sessionWrong == 1 ? "fallo" : "fallos")</p>
            }
            <button class="btn-primary" @onclick="StartAgainAsync">@(Mode == PracticeKind.Quick ? "Otro mini test" : "Seguir repasando")</button>
            <a class="btn-outline-dark btn-link" href="">Volver a Inicio</a>
        }
    </div>
}
else if (_question is not null)
{
    <div class="ts-header">
        <div class="ts-header-main">
            <div class="ts-header-line">
                <h1 class="ts-title">@Title</h1>
                <span class="ts-count">Pregunta @(_answered + (_result is null ? 1 : 0)) de @_total</span>
            </div>
            <div class="progress-track"><div class="progress-fill" style="width: @(ProgressPercent)%"></div></div>
        </div>
        @if (_sessionCorrect + _sessionWrong > 0)
        {
            <div class="ts-tally" aria-label="Resultado de esta sesión">
                <span class="ts-pill ok">@_sessionCorrect @(_sessionCorrect == 1 ? "acierto" : "aciertos")</span>
                <span class="ts-pill ko">@_sessionWrong @(_sessionWrong == 1 ? "fallo" : "fallos")</span>
            </div>
        }
    </div>

    <div class="ts-layout">
        <section class="ts-main">
            <div class="ts-card">
                @* TEMPORAL: id de la pregunta (tabla Questions) para localizar errores durante las pruebas. *@
                <span class="debug-id">Q@(_question.Id)</span>
                <p class="ts-question">@_question.Text</p>

                <div class="ts-answers">
                    @for (var i = 0; i < _question.Answers.Count; i++)
                    {
                        var answer = _question.Answers[i];
                        var letter = (char)('A' + i);
                        var state = AnswerClass(answer);
                        <button class="ts-answer @state @(_result is not null && state is null ? "dim" : null)"
                                disabled="@(_result is not null)"
                                @onpointerdown="OnAnswerPointerDown"
                                @onclick="e => AnswerIfTapAsync(answer, e)">
                            <span class="ts-letter">@letter</span>
                            <span class="ts-answer-text">@answer.Text</span>
                            @if (state == "correct")
                            {
                                <svg class="ts-mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Respuesta correcta"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                            }
                            else if (state == "wrong")
                            {
                                <svg class="ts-mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" role="img" aria-label="Tu respuesta, incorrecta"><path d="M6 6l12 12M18 6L6 18" /></svg>
                            }
                        </button>
                    }
                </div>

                @if (_result is null)
                {
                    <p class="ts-hint">Pulsa una respuesta o usa las teclas 1–@_question.Answers.Count.</p>
                }
            </div>

            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }

            @if (_result is not null)
            {
                <div class="ts-verdict @(_result.IsCorrect ? "ok" : "ko")" role="status">
                    <strong class="ts-verdict-title">@(_result.IsCorrect ? "¡Correcto!" : $"Casi: la correcta es la {CorrectLetter}")</strong>
                    <div class="ts-verdict-actions">
                        <button class="btn-primary ts-next" @ref="_nextRef" @onclick="NextQuestion">
                            @(_remaining.Count == 0 ? "Terminar tema" : "Siguiente pregunta")
                        </button>
                        @if (HasExplanation)
                        {
                            <button class="ts-secondary" @onclick="() => _showExplanation = !_showExplanation">
                                @(_showExplanation ? "Ocultar explicación" : "Ver explicación")
                            </button>
                        }
                    </div>
                </div>
            }
        </section>

        <aside class="ts-aside">
            @if (_result is not null && HasExplanation && _showExplanation)
            {
                <div class="ts-explanation">
                    @if (ExplanationImageUrl is not null)
                    {
                        <button class="ts-image-btn" title="Ver a pantalla completa" @onclick="() => _showImageFullscreen = true">
                            <img src="@ExplanationImageUrl" alt="Imagen de la explicación" />
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_result.Explanation))
                    {
                        <div class="ts-explanation-body">
                            <h2 class="ts-explanation-title">Por qué</h2>
                            <div class="explanation-text">@((MarkupString)_result.Explanation)</div>
                        </div>
                    }
                </div>
            }
            <div class="ts-shortcuts">
                <strong>Atajos</strong>
                <span><kbd>1</kbd>–<kbd>4</kbd> responder · <kbd>Intro</kbd> siguiente · <kbd>E</kbd> explicación</span>
            </div>
        </aside>
    </div>
}
</div>

@if (_showImageFullscreen && ExplanationImageUrl is not null)
{
    @* Fullscreen viewer: any click closes it. *@
    <div class="lightbox" @onclick="() => _showImageFullscreen = false">
        <img src="@ExplanationImageUrl" alt="Explicación" />
        <button class="lightbox-close" aria-label="Cerrar">✕</button>
    </div>
}

@if (_showRestartConfirm)
{
    @* Styled replacement for the browser's confirm(): backdrop cancels, the card
       swallows its clicks. *@
    <div class="modal-backdrop" @onclick="() => _showRestartConfirm = false">
        <div class="modal-card" @onclick:stopPropagation>
            <h2 class="modal-title">Reiniciar tema</h2>
            <p class="modal-text">Se borrará todo tu historial de este tema y empezarás desde el principio. ¿Quieres continuar?</p>
            <div class="modal-actions">
                <button class="btn-outline-dark" @onclick="() => _showRestartConfirm = false">Cancelar</button>
                <button class="btn-primary" @onclick="RestartTopicAsync">Reiniciar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Number { get; set; }

    // "/practica/fallos" (Review) or "/practica/mini" (Quick); null on a topic route.
    [Parameter] public string? Practica { get; set; }

    private enum PracticeKind { Topic, Review, Quick }

    private PracticeKind Mode => Practica switch
    {
        "fallos" => PracticeKind.Review,
        "mini" => PracticeKind.Quick,
        _ => PracticeKind.Topic,
    };

    private string BackHref => Mode == PracticeKind.Topic ? "temas" : "";
    private string BackText => Mode == PracticeKind.Topic ? "Volver a los temas" : "Volver a Inicio";

    private string CompletedText => Mode == PracticeKind.Quick
        ? "¡Mini test terminado!"
        : "¡No te quedan fallos por repasar!";

    [SupplyParameterFromQuery(Name = "nombre")]
    public string? Nombre { get; set; }

    [SupplyParameterFromQuery(Name = "completado")]
    public bool Completado { get; set; }

    private string Title => Mode switch
    {
        PracticeKind.Review => "Repaso de fallos",
        PracticeKind.Quick => "Mini test",
        _ => Nombre ?? $"Tema {Number}",
    };

    private long _licenseId;
    private long _sessionId;
    private readonly Queue<SessionQuestionDto> _remaining = new();
    private int _total;
    private int _answered;
    private SessionQuestionDto? _question;
    private SubmitAnswerResultDto? _result;
    private long _chosenId;
    private bool _showExplanation;
    private bool _showImageFullscreen;
    private bool _showRestartConfirm;
    private bool _completed;
    private bool _loaded;
    private bool _loadFailed;
    private bool _paywall;
    private string? _error;

    // Right/wrong count of this visit (not the topic's history), for the header pills.
    private int _sessionCorrect;
    private int _sessionWrong;

    // Keyboard: the page wrapper holds focus while a question waits for an answer
    // (1–4 answer it); after answering, focus moves to "Siguiente" so Enter is the
    // button's own click and never fires twice.
    private ElementReference _pageRef;
    private ElementReference _nextRef;
    private bool _focusPage = true;
    private bool _focusNext;

    private int ProgressPercent => _total == 0 ? 0 : (int)Math.Round(100.0 * _answered / _total);

    private char CorrectLetter =>
        (char)('A' + Math.Max(0, _question?.Answers.FindIndex(a => a.Id == _result?.CorrectAnswerId) ?? 0));

    private bool HasExplanation =>
        !string.IsNullOrWhiteSpace(_result?.Explanation) || ExplanationImageUrl is not null;

    // The DB stores relative paths ("images/questions/x.png") — same fix-up as the
    // app's TopicSessionViewModel.BuildImageUrl.
    private string? ExplanationImageUrl =>
        string.IsNullOrWhiteSpace(_result?.ExplanationImageUrl)
            ? null
            : Uri.IsWellFormedUriString(_result.ExplanationImageUrl, UriKind.Absolute)
                ? _result.ExplanationImageUrl
                : Api.Url(_result.ExplanationImageUrl);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var selection = await LicensesApi.GetSelectedLicenseAsync();
            if (selection.LicenseId is not long licenseId)
            {
                Navigation.NavigateTo("/");
                return;
            }
            _licenseId = licenseId;

            // Already-completed topic: land on the completed screen without starting
            // a session — starting one would re-plan the full question set.
            if (Completado && Mode == PracticeKind.Topic)
            {
                _completed = true;
                _loaded = true;
                return;
            }

            await StartSessionAsync();
        }
        catch (Exception ex) when (Paywall.IsPaywall(ex))
        {
            _paywall = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task StartSessionAsync()
    {
        PracticeSessionDto session;
        try
        {
            session = Mode switch
            {
                PracticeKind.Review => await SessionsApi.StartReviewAsync(new StartLicensePracticeRequestDto(_licenseId)),
                PracticeKind.Quick => await SessionsApi.StartQuickAsync(new StartLicensePracticeRequestDto(_licenseId)),
                _ => await SessionsApi.StartTopicPracticeAsync(new StartTopicPracticeRequestDto(Number, _licenseId)),
            };
        }
        catch (Refit.ApiException ex) when (Mode == PracticeKind.Review && ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // Nothing to review: the API plans no session without failed questions.
            _loaded = true;
            _completed = true;
            return;
        }

        _sessionId = session.SessionId;
        _total = session.TotalQuestions;
        _answered = session.AnsweredCount;

        _remaining.Clear();
        foreach (var question in session.RemainingQuestions)
            _remaining.Enqueue(question);

        _loaded = true;
        ShowNextQuestion();
    }

    private void ShowNextQuestion()
    {
        _result = null;
        _error = null;
        _showExplanation = false;
        _showImageFullscreen = false;

        if (_remaining.Count == 0)
        {
            _question = null;
            _completed = true;
            return;
        }

        _question = _remaining.Peek();
        _focusPage = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_focusNext)
            {
                _focusNext = false;
                await _nextRef.FocusAsync();
            }
            else if (_focusPage && _question is not null)
            {
                _focusPage = false;
                await _pageRef.FocusAsync(preventScroll: true);
            }
        }
        catch (Exception)
        {
            // An element that left the DOM in the meantime — nothing to focus.
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (_question is null || _showRestartConfirm || _showImageFullscreen) return;

        if (_result is null && e.Key.Length == 1 && char.IsDigit(e.Key[0]))
        {
            var index = e.Key[0] - '1';
            if (index >= 0 && index < _question.Answers.Count)
                await AnswerAsync(_question.Answers[index]);
        }
        else if (_result is not null && (e.Key == "e" || e.Key == "E") && HasExplanation)
        {
            _showExplanation = !_showExplanation;
        }
    }

    private double _pointerDownY;

    private void OnAnswerPointerDown(PointerEventArgs e) => _pointerDownY = e.ClientY;

    // A finger that moved vertically between touch and release was SCROLLING —
    // on phones that must not answer the question it happened to land on.
    private async Task AnswerIfTapAsync(SessionAnswerOptionDto answer, MouseEventArgs e)
    {
        if (Math.Abs(e.ClientY - _pointerDownY) > 12) return;

        await AnswerAsync(answer);
    }

    private async Task AnswerAsync(SessionAnswerOptionDto answer)
    {
        if (_result is not null || _question is null) return;

        _error = null;
        try
        {
            var result = await SessionsApi.SubmitAnswerAsync(_sessionId, new SubmitAnswerRequestDto(_question.Id, answer.Id));

            _chosenId = answer.Id;
            _result = result;
            _remaining.Dequeue();
            _answered++;
            if (result.IsCorrect) _sessionCorrect++; else _sessionWrong++;
            _showExplanation = true;
            _focusNext = true;
        }
        catch (Exception)
        {
            // The answer did not reach the server — the user can tap again.
            _error = "Ha ocurrido un error desconocido. Por favor, inténtalo de nuevo.";
        }
    }

    private string? AnswerClass(SessionAnswerOptionDto answer)
    {
        if (_result is null) return null;
        if (answer.Id == _result.CorrectAnswerId) return "correct";
        if (answer.Id == _chosenId) return "wrong";
        return null;
    }

    private void NextQuestion() => ShowNextQuestion();

    // "Otro mini test" / "Seguir repasando" on the completed screen.
    private async Task StartAgainAsync()
    {
        _completed = false;
        _loaded = false;
        _sessionCorrect = 0;
        _sessionWrong = 0;
        try
        {
            await StartSessionAsync();
        }
        catch (Exception ex) when (Paywall.IsPaywall(ex))
        {
            _paywall = true;
        }
        catch (Exception)
        {
            _loaded = true;
            _loadFailed = true;
        }
    }

    // Deletes the user's whole history for this topic on the server, then starts the
    // topic again from question 1 — same behavior as the app's restart button.
    // Reached only through the styled confirmation modal above.
    private async Task RestartTopicAsync()
    {
        _showRestartConfirm = false;

        try
        {
            await SessionsApi.ResetTopicPracticeAsync(new ResetTopicPracticeRequestDto(Number, _licenseId));

            _completed = false;
            _loaded = false;
            await StartSessionAsync();
        }
        catch (Exception ex) when (Paywall.IsPaywall(ex))
        {
            _paywall = true;
        }
        catch (Exception)
        {
            _loaded = true;
            _error = "Ha ocurrido un error desconocido. Por favor, inténtalo de nuevo.";
        }
    }
}

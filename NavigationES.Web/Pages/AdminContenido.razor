@page "/admin/contenido"
@attribute [Authorize(Roles = WebAuthStateProvider.AdminRole)]
@inject IAdminApi AdminApi

<PageTitle>Contenido — NavigationES</PageTitle>

<div class="admin-page">
    <h1>Contenido</h1>
    <p class="tagline">
        @if (_content is null)
        {
            <text>Cargando…</text>
        }
        else
        {
            <text>@_content.Topics.Count temas · @TotalBank preguntas en el banco · @TotalExams simulaciones con @TotalExamQuestions preguntas</text>
        }
    </p>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else if (_content is null)
    {
        <p class="page-loading">Cargando…</p>
    }
    else
    {
        <div class="admin-grid">
            <section class="retro-card admin-card">
                <h2 class="admin-subtitle">Temas por titulación</h2>
                <p class="admin-hint">
                    Cada titulación con los temas que examina: Banco = preguntas activas del tema,
                    En examen = cuántas entran en un examen y cuántos errores se toleran en ellas.
                    Un tema compartido aparece en todas las titulaciones que lo examinan.
                </p>
                @foreach (var l in _content.Licenses)
                {
                    var rows = TopicsOf(l);
                    var inactive = rows.Sum(r => r.Topic.InactiveQuestionCount);
                    <div class="admin-license-block">
                        <div class="admin-license-head">
                            <h3 class="admin-license-code">@l.Code</h3>
                            <span class="admin-license-name">@l.Name</span>
                            <span class="admin-license-meta">@(rows.Count == 0 ? "Sin temas configurados todavía" : ExamRules(l))</span>
                        </div>
                        @if (rows.Count > 0)
                        {
                            <div class="admin-table-wrap">
                                <table class="admin-table admin-table-stats admin-table-topics">
                                    <thead>
                                        <tr>
                                            <th>Tema</th>
                                            <th class="admin-num">Banco</th>
                                            <th class="admin-num">En examen</th>
                                            <th class="admin-num">Máx. errores</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in rows)
                                        {
                                            <tr class="@(row.Topic.ActiveQuestionCount == 0 ? "is-empty" : null)">
                                                <td><div class="admin-user-name">@(row.Topic.Number). @row.Topic.Name</div></td>
                                                <td class="admin-num">
                                                    <strong>@row.Topic.ActiveQuestionCount</strong>
                                                    @if (row.Topic.InactiveQuestionCount > 0)
                                                    {
                                                        <span class="admin-small admin-block">+@row.Topic.InactiveQuestionCount inactivas</span>
                                                    }
                                                </td>
                                                <td class="admin-num"><strong>@row.Blueprint.QuestionsInExam</strong></td>
                                                <td class="admin-num">
                                                    @if (row.Blueprint.MaxErrors is null)
                                                    {
                                                        <span class="admin-dash">—</span>
                                                    }
                                                    else
                                                    {
                                                        @row.Blueprint.MaxErrors
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>@l.TopicCount @(l.TopicCount == 1 ? "tema" : "temas")</td>
                                            <td class="admin-num">
                                                @l.BankQuestionCount
                                                @if (inactive > 0)
                                                {
                                                    <span class="admin-small admin-block">+@inactive inactivas</span>
                                                }
                                            </td>
                                            <td class="admin-num">@l.QuestionsInExam</td>
                                            <td class="admin-num">
                                                @if (l.MaxTotalErrors is null)
                                                {
                                                    <span class="admin-dash">—</span>
                                                }
                                                else
                                                {
                                                    @l.MaxTotalErrors
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="retro-card admin-card">
                <h2 class="admin-subtitle">Simulaciones por comunidad</h2>
                <p class="admin-hint">
                    Exámenes reales importados por comunidad autónoma y titulación, con sus preguntas
                    y los años que cubren.
                </p>
                <div class="admin-table-wrap">
                    <table class="admin-table admin-table-stats">
                        <thead>
                            <tr>
                                <th>Comunidad</th>
                                @foreach (var l in _content.Licenses)
                                {
                                    <th class="admin-num" title="@l.Name">@l.Code</th>
                                }
                                <th class="admin-num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _content.Comunidades)
                            {
                                var total = c.Licenses.Sum(x => x.ExamCount);
                                <tr class="@(total == 0 ? "is-empty" : null)">
                                    <td><div class="admin-user-name">@c.Name</div></td>
                                    @foreach (var l in _content.Licenses)
                                    {
                                        var cell = c.Licenses.FirstOrDefault(x => x.LicenseId == l.Id);
                                        <td class="admin-num">
                                            @if (cell is null)
                                            {
                                                <span class="admin-dash">—</span>
                                            }
                                            else
                                            {
                                                <strong>@cell.ExamCount</strong>
                                                <span class="admin-small admin-block">@cell.QuestionCount preg. · @Years(cell.FirstYear, cell.LastYear)</span>
                                            }
                                        </td>
                                    }
                                    <td class="admin-num"><strong>@total</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                @foreach (var l in _content.Licenses)
                                {
                                    <td class="admin-num">@l.ExamCount</td>
                                }
                                <td class="admin-num">@TotalExams</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private AdminContentDto? _content;
    private string? _error;

    private int TotalBank => _content?.Topics.Sum(t => t.ActiveQuestionCount) ?? 0;
    private int TotalExams => _content?.Licenses.Sum(l => l.ExamCount) ?? 0;
    private int TotalExamQuestions => _content?.Comunidades.Sum(c => c.Licenses.Sum(x => x.QuestionCount)) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _content = await AdminApi.GetContentAsync();
        }
        catch (Exception)
        {
            // A 401 already redirected to /signin; a 403 means the admin flag was
            // revoked since sign-in — either way there is nothing to show here.
            _error = ErrorMessages.Translate(null);
        }
    }

    // The topics one titulación examines, in syllabus order, each with its blueprint
    // row. A topic several titulaciones share is listed under each of them — the same
    // bank, but a different number of questions and error limit in every exam.
    private List<(AdminTopicDto Topic, AdminTopicLicenseDto Blueprint)> TopicsOf(AdminLicenseDto license)
    {
        var rows = new List<(AdminTopicDto, AdminTopicLicenseDto)>();
        foreach (var topic in _content!.Topics)
        {
            var blueprint = topic.Licenses.FirstOrDefault(x => x.LicenseId == license.Id);
            if (blueprint is not null)
                rows.Add((topic, blueprint));
        }
        return rows;
    }

    // "11 temas · 45 preguntas por examen · máx. 13 errores" — the license's exam
    // rules; the error limit is missing while the official rules are not configured.
    private static string ExamRules(AdminLicenseDto l)
    {
        var rules = $"{l.TopicCount} {(l.TopicCount == 1 ? "tema" : "temas")} · {l.QuestionsInExam} preguntas por examen";
        return l.MaxTotalErrors is null ? rules : $"{rules} · máx. {l.MaxTotalErrors} errores";
    }

    // "2023" for a single year, "2019–2025" for a range.
    // Null on both ends means every paper here arrived without a date.
    private static string Years(int? first, int? last) =>
        first is null || last is null ? "sin fecha"
        : first == last ? first.ToString()!
        : $"{first}–{last}";
}

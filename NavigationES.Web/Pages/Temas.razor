@page "/temas"
@attribute [Authorize]
@inject ILicensesApi LicensesApi
@inject ITopicsApi TopicsApi
@inject NavigationManager Navigation
@using System.Globalization

<PageTitle>Práctica por temas — NavigationES</PageTitle>

@if (_topics is null)
{
    <p class="page-loading">Cargando…</p>
}
else if (_loadFailed)
{
    <p class="error" role="alert">Ha ocurrido un error desconocido. Por favor, inténtalo de nuevo.</p>
}
else
{
    <div class="temas-grid">
        <section class="retro-card">
            <h2 class="retro-title">Selecciona un tema</h2>

            <div class="topic-squares">
                @foreach (var topic in _topics)
                {
                    var percent = Percent(topic);
                    <button class="topic-square" disabled="@(topic.QuestionCount == 0)"
                            title="@TopicTitle(topic)"
                            @onclick="() => OpenTopic(topic)">
                        <span class="topic-num">@topic.Number</span>
                        <span class="topic-square-name">@topic.Name</span>
                        @if (topic.QuestionCount == 0)
                        {
                            <span class="topic-square-empty">Sin preguntas</span>
                        }
                        else
                        {
                            <span class="topic-square-count">@topic.QuestionCount preguntas</span>
                            <span class="topic-square-footer">
                                <span class="progress-track"><span class="progress-fill" style="width: @(percent)%"></span></span>
                                <span class="topic-square-pct">@percent%</span>
                            </span>
                        }
                    </button>
                }
            </div>
        </section>

        <aside class="retro-card temas-stats">
            <h2 class="retro-title">Tu progreso</h2>

            <div class="donut" style="@_donutStyle">
                <div class="donut-center">
                    <span class="donut-pct">@_correctPercent%</span>
                    <span class="donut-sub">aciertos</span>
                </div>
            </div>

            <ul class="donut-legend">
                <li><span class="chip chip-ok"></span><span>Aciertos</span><strong>@_correct</strong></li>
                <li><span class="chip chip-ko"></span><span>Fallos</span><strong>@_failed</strong></li>
                <li><span class="chip chip-rest"></span><span>Sin responder</span><strong>@_remaining</strong></li>
            </ul>

            <p class="stats-summary">
                Realizadas <strong>@(_correct + _failed)</strong> de <strong>@_totalQuestions</strong> preguntas
            </p>
        </aside>
    </div>
}

@code {
    private List<TopicProgressDto>? _topics;
    private bool _loadFailed;
    private int _totalQuestions;
    private int _correct;
    private int _failed;
    private int _remaining;
    private int _correctPercent;
    private string _donutStyle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // No qualification chosen yet — the home page is where that happens.
            var selection = await LicensesApi.GetSelectedLicenseAsync();
            if (selection.LicenseId is not long licenseId)
            {
                Navigation.NavigateTo("/");
                return;
            }

            var result = await TopicsApi.GetTopicsAsync(licenseId);
            _topics = result.Topics;

            _totalQuestions = _topics.Sum(t => t.QuestionCount);
            _correct = _topics.Sum(t => t.CorrectCount);
            _failed = _topics.Sum(t => t.FailedCount);
            _remaining = _totalQuestions - _correct - _failed;
            _correctPercent = _totalQuestions == 0 ? 0 : (int)Math.Round(100.0 * _correct / _totalQuestions);
            _donutStyle = BuildDonutStyle();
        }
        catch (Exception)
        {
            _topics = [];
            _loadFailed = true;
        }
    }

    private static int Percent(TopicProgressDto topic) =>
        topic.QuestionCount == 0 ? 0 : (int)Math.Round(100.0 * topic.CorrectCount / topic.QuestionCount);

    private static string TopicTitle(TopicProgressDto topic) =>
        topic.QuestionCount == 0
            ? "Este tema todavía no tiene preguntas."
            : $"{topic.QuestionCount} preguntas · {topic.CorrectCount} aciertos · {topic.FailedCount} fallos";

    private void OpenTopic(TopicProgressDto topic)
    {
        // A fully-correct topic opens on the completed screen (with "Reiniciar tema")
        // instead of silently starting a fresh full run — the server would otherwise
        // plan the whole question set again on the start call.
        var completed = topic.QuestionCount > 0 && topic.CorrectCount == topic.QuestionCount;

        Navigation.NavigateTo($"temas/{topic.Number}?nombre={Uri.EscapeDataString(topic.Name)}" +
                              (completed ? "&completado=true" : string.Empty));
    }

    // Donut segments as a conic-gradient: aciertos (teal), fallos (red), unanswered
    // (neutral gray), with a thin surface gap between non-empty neighbours (the
    // "2px gap between fills" mark rule, expressed in arc percent).
    private string BuildDonutStyle()
    {
        var segments = new List<(string Color, double Share)>();
        if (_totalQuestions > 0)
        {
            if (_correct > 0) segments.Add(("#2AA5A0", 100.0 * _correct / _totalQuestions));
            if (_failed > 0) segments.Add(("#D64545", 100.0 * _failed / _totalQuestions));
            if (_remaining > 0) segments.Add(("#AEBACA", 100.0 * _remaining / _totalQuestions));
        }

        if (segments.Count == 0)
            return "background: conic-gradient(#AEBACA 0 100%)";
        if (segments.Count == 1)
            return $"background: conic-gradient({segments[0].Color} 0 100%)";

        var stops = new List<string>();
        var cursor = 0.0;
        foreach (var (color, share) in segments)
        {
            // A sliver of a segment keeps at least a third of itself visible.
            var gap = Math.Min(1.1, share / 3);
            stops.Add($"white {F(cursor)}% {F(cursor + gap / 2)}%, " +
                      $"{color} {F(cursor + gap / 2)}% {F(cursor + share - gap / 2)}%, " +
                      $"white {F(cursor + share - gap / 2)}% {F(cursor + share)}%");
            cursor += share;
        }

        return $"background: conic-gradient({string.Join(", ", stops)})";
    }

    // The style attribute needs a decimal POINT whatever the browser culture is.
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}

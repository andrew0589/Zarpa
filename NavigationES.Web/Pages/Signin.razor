@page "/signin"
@inject IAuthApi AuthApi
@inject WebAuthStateProvider Auth
@inject NavigationManager Navigation
@inject ApiOptions Api

<PageTitle>Iniciar sesión — NavigationES</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Bienvenido</h1>
        <p class="tagline">Prepárate para tus titulaciones náuticas</p>

        <label for="email">Correo electrónico</label>
        <input id="email" type="email" autocomplete="email"
               placeholder="nombre@dominio.com"
               @bind="_email" @bind:event="oninput" />

        <label for="password">Contraseña</label>
        <input id="password" type="password" autocomplete="current-password"
               placeholder="••••••••"
               @bind="_password" @bind:event="oninput"
               @onkeydown="OnPasswordKeyDown" />

        <p style="text-align: right; margin-top: 8px; margin-bottom: 16px;">
            <a href="forgot-password.html" style="font-size: 0.9em; color: #666; text-decoration: none;">¿Olvidaste la contraseña?</a>
        </p>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <button class="btn-primary" disabled="@_busy" @onclick="SigninAsync">
            @(_busy ? "Entrando…" : "Entrar  →")
        </button>

        <div class="divider"><span>O continúa con</span></div>

        <button class="btn-social" @onclick="@(() => SocialSignin("google"))">Google</button>
        <button class="btn-social" @onclick="@(() => SocialSignin("apple"))">Apple</button>
        <button class="btn-social" @onclick="@(() => SocialSignin("facebook"))">Facebook</button>

        <p class="auth-footer">
            ¿No tienes cuenta? <a href="signup">Crea una cuenta nueva</a>
        </p>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        // Already signed in (e.g. navigated to /signin by hand) — straight home.
        var state = await Auth.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }

    // The whole OAuth flow happens between the browser and the API; ?client=web makes
    // the API's callback land on /auth-callback here instead of the app's navigationes:// scheme.
    private void SocialSignin(string provider) =>
        Navigation.NavigateTo(Api.Url($"api/auth/{provider}/start?client=web"), forceLoad: true);

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SigninAsync();
    }

    private async Task SigninAsync()
    {
        if (_busy) return;

        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "¡Por favor, agrega un correo electrónico válido!";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "¡Contraseña incorrecta!";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthApi.SigninAsync(new SigninRequestDto(_email.Trim(), _password));

            if (result.IsSuccess)
            {
                await Auth.SigninAsync(result.Data);
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = ErrorMessages.Translate(result.ErrorCode);
            }
        }
        catch (Exception)
        {
            _error = ErrorMessages.Translate(null);
        }
        finally
        {
            _busy = false;
        }
    }
}

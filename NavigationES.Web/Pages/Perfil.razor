@page "/perfil"
@attribute [Authorize]
@inject WebAuthStateProvider Auth
@inject IAuthApi AuthApi
@inject NavigationManager Navigation
@using NavigationES.Shared.Constants

<PageTitle>Perfil — NavigationES</PageTitle>

<div class="perfil-grid">
    <div class="perfil-left">
        <section class="retro-card">
            <h2 class="retro-title">Tu titulación</h2>
            <LicenseSelector />
        </section>

        <section class="retro-card">
            <h2 class="retro-title">Tu comunidad autónoma</h2>
            <ComunidadSelector />
        </section>
    </div>

    <section class="retro-card">
        <h2 class="retro-title">Datos personales</h2>

        <div class="retro-avatar">@Initial</div>

        <dl class="datos-list">
            <div class="datos-row">
                <dt>
                    <span>Nombre</span>
                    @if (!_editingName)
                    {
                        <button type="button" class="datos-edit" @onclick="StartEditName">Editar</button>
                    }
                </dt>
                @if (!_editingName)
                {
                    <dd>@Auth.User?.Name</dd>
                }
                else
                {
                    @* Inline rename: Enter saves, Escape cancels. *@
                    <div class="datos-editor">
                        <input class="datos-input" maxlength="50" disabled="@_savingName"
                               @bind="_nameDraft" @bind:event="oninput" @onkeydown="OnNameKeyDownAsync" />
                        @if (_nameError is not null)
                        {
                            <p class="error" role="alert">@_nameError</p>
                        }
                        <div class="datos-actions">
                            <button type="button" class="btn-cancel" disabled="@_savingName" @onclick="CancelEditName">Cancelar</button>
                            <button type="button" class="btn-primary" disabled="@_savingName" @onclick="SaveNameAsync">
                                @(_savingName ? "Guardando…" : "Guardar")
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="datos-row">
                <dt>Correo</dt>
                <dd>@Auth.User?.Email</dd>
            </div>
        </dl>

        @if (Auth.User?.IsEmailVerified == true)
        {
            <span class="retro-tag ok">✓ Correo verificado</span>
        }
        else
        {
            <span class="retro-tag warn">Correo sin verificar</span>
        }

        <div class="danger-zone">
            <h3 class="danger-title">Zona de peligro</h3>

            @if (!_confirmingDelete)
            {
                <button class="btn-danger-outline" @onclick="() => _confirmingDelete = true">
                    Eliminar cuenta
                </button>
            }
            else
            {
                <p class="danger-warning">
                    Se eliminará tu cuenta y todo tu progreso (tests, exámenes y
                    estadísticas) de forma permanente. Esta acción no se puede deshacer.
                </p>

                @if (_deleteError is not null)
                {
                    <p class="error" role="alert">@_deleteError</p>
                }

                <div class="danger-actions">
                    <button class="btn-cancel" disabled="@_deleting"
                            @onclick="() => { _confirmingDelete = false; _deleteError = null; }">
                        Cancelar
                    </button>
                    <button class="btn-danger" disabled="@_deleting" @onclick="DeleteAccountAsync">
                        @(_deleting ? "Eliminando…" : "Sí, eliminar mi cuenta")
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private bool _confirmingDelete;
    private bool _deleting;
    private string? _deleteError;

    private string Initial =>
        string.IsNullOrWhiteSpace(Auth.User?.Name) ? "?" : Auth.User.Name.Trim()[..1].ToUpperInvariant();

    private bool _editingName;
    private bool _savingName;
    private string _nameDraft = string.Empty;
    private string? _nameError;

    private void StartEditName()
    {
        _nameDraft = Auth.User?.Name ?? string.Empty;
        _nameError = null;
        _editingName = true;
    }

    private void CancelEditName()
    {
        if (_savingName) return;

        _editingName = false;
        _nameError = null;
    }

    private async Task OnNameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNameAsync();
        else if (e.Key == "Escape") CancelEditName();
    }

    private async Task SaveNameAsync()
    {
        if (_savingName) return;

        // Same limit as the API (UserEntity.Name is 50 chars).
        var name = _nameDraft.Trim();
        if (name.Length is 0 or > 50)
        {
            _nameError = ErrorMessages.Translate(ErrorCodes.NameNotValidError);
            return;
        }

        if (name == Auth.User?.Name)
        {
            _editingName = false;
            return;
        }

        _savingName = true;
        _nameError = null;
        try
        {
            var result = await AuthApi.UpdateNameAsync(new UpdateNameRequestDto(name));

            if (result.IsSuccess)
            {
                // The API answers with a refreshed session (the JWT carries the first
                // name) — stored like a sign-in, so the top bar picks the new name up.
                await Auth.SigninAsync(result.Data);
                _editingName = false;
            }
            else
            {
                _nameError = ErrorMessages.Translate(result.ErrorCode);
            }
        }
        catch (Exception)
        {
            _nameError = ErrorMessages.Translate(null);
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (_deleting) return;

        _deleting = true;
        _deleteError = null;
        try
        {
            var result = await AuthApi.DeleteAccountAsync();

            if (result.IsSuccess)
            {
                // The account is gone; the local token now points at nothing.
                await Auth.SignoutAsync();
                Navigation.NavigateTo("signin");
            }
            else
            {
                _deleteError = ErrorMessages.Translate(result.ErrorMessage);
            }
        }
        catch (Exception)
        {
            _deleteError = ErrorMessages.Translate(null);
        }
        finally
        {
            _deleting = false;
        }
    }
}

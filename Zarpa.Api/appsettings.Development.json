    "SenderEmail": "liviu.andrei.la@gmail.com",
    "SenderName": "Zarpa",
    "Username": "liviu.andrei.la@gmail.com",
    "EnableSsl": "true"
  },
  "Cors": {
    // Zarpa.Web dev server (see Zarpa.Web/Properties/launchSettings.json).
    "AllowedOrigins": [ "https://localhost:7200", "http://localhost:5200" ]

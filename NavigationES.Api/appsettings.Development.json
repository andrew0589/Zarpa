{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "NavigationESDb": "Server=localhost\\SQLEXPRESS;Initial Catalog=NavigationESDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "AppSettings": {
    // NavigationES.Web dev server — used for the web social-login callback and reset links.
    "FrontendUrl": "https://localhost:7200"
  },
  "AdminSettings": {
    // Shared secret for the /api/admin/* import endpoints (X-Admin-Key header).
    // Dev-only value; in production set AdminSettings__ApiKey as a long random env var.
    "ApiKey": "dev-admin-key-change-me"
  },
  "Authentication": {
    "Google": {
      // ClientId is public (paste it from the Google Cloud OAuth client here).
      // The ClientSecret is NOT here — it lives in user-secrets:
      //   dotnet user-secrets set "Authentication:Google:ClientSecret" "..." --project NavigationES.Api
      "ClientId": "TODO-paste-google-client-id"
    }
  },
  "EmailSettings": {
    // smtp4dev: local mail catcher — no password, nothing leaves the machine.
    // Start it with `smtp4dev` (installed as a dotnet global tool; config in
    // ~/.smtp4dev) and read every sent email at http://localhost:5010.
    // To send REAL mail via Gmail instead: SmtpServer smtp.gmail.com, port 587,
    // EnableSsl true, and an APP password in user-secrets:
    //   dotnet user-secrets set "EmailSettings:Password" "xxxx xxxx xxxx xxxx"
    "SmtpServer": "localhost",
    "SmtpPort": "2525",
    "SenderEmail": "liviu.andrei.la@gmail.com",
    "SenderName": "NavigationES",
    "Username": "liviu.andrei.la@gmail.com",
    "EnableSsl": "false"
  },
  "Cors": {
    // NavigationES.Web dev server (see NavigationES.Web/Properties/launchSettings.json); the LAN
    // IP entry lets phones on the same Wi-Fi use the site. Update it if DHCP
    // hands the PC a different address.
    "AllowedOrigins": [ "https://localhost:7200", "http://localhost:5200", "http://192.168.1.136:5200" ]
  },
  "Jwt": {
    // Placeholder dev secret — long enough for HMAC-SHA256; replace before sharing anything real.
    "SecretKey": "TODO-REPLACE-dev-only-secret-key-must-be-long-and-random-0123456789abcdef",
    "Issuer": "http://0.0.0.0:7136",
    "ExpireInMinute": 10080
  }
}
